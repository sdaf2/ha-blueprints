blueprint:
  name: "Welcome Home + Presencia (Flexible)"
  description: >
    Enciende luces al llegar a casa (GPS) o por presencia.
    Permite definir qué luces se apagarán solas y cuáles quedarán encendidas permanentemente.
  domain: automation
  input:
    # 1. DISPARADORES
    authorized_people:
      name: "👥 Miembros Autorizados"
      selector:
        entity:
          domain: person
          multiple: true

    motion_sensor:
      name: "🏃 Sensor de Presencia (Opcional)"
      default: []
      selector:
        entity:
          domain: binary_sensor
          device_class: motion

    # 2. DISPOSITIVOS (DIFERENCIADOS)
    target_lights_auto:
      name: "💡 Luces con Auto-Apagado"
      description: "Luces que seguirán la lógica de temporizadores (cortesía/presencia)."
      default: { "entities": [] }
      selector:
        target:
          entity:
            - domain: light
            - domain: switch

    target_lights_permanent:
      name: "🔦 Luces Permanentes"
      description: "Luces que se encenderán pero NO se apagarán automáticamente."
      default: { "entities": [] }
      selector:
        target:
          entity:
            - domain: light
            - domain: switch

    # 3. CONDICIONES
    only_at_night:
      name: "🌙 Activar solo de noche"
      default: true
      selector:
        boolean: {}

    illuminance_sensor:
      name: "☀️ Sensor de Luminosidad (Opcional)"
      default: []
      selector:
        entity:
          domain: sensor
          device_class: illuminance

    illuminance_threshold:
      name: "↳ Umbral de Lux"
      default: 50
      selector:
        number:
          min: 1
          max: 1000
          unit_of_measurement: "lux"

    # 4. TIEMPOS
    on_delay:
      name: "⏳ Retraso de Inicio (Movimiento)"
      default: 0
      selector:
        number:
          min: 0
          max: 60
          unit_of_measurement: "segundos"

    arrival_duration:
      name: "⏱️ Tiempo de Cortesía (Llegada)"
      description: "Minutos para apagar si no hay movimiento tras llegar."
      default: 5
      selector:
        number:
          min: 1
          max: 30
          unit_of_measurement: "minutos"

    off_delay:
      name: "⏱️ Temporizador de Salida (Presencia)"
      description: "Segundos sin movimiento antes de apagar."
      default: 120
      selector:
        number:
          min: 10
          max: 3600
          unit_of_measurement: "segundos"

mode: restart

variables:
  v_solo_noche: !input only_at_night
  v_lux_sensor: !input illuminance_sensor
  v_lux_threshold: !input illuminance_threshold
  v_motion_sensor: !input motion_sensor
  v_on_delay: !input on_delay
  v_arrival_min: !input arrival_duration
  v_off_sec: !input off_delay
  v_lights_auto: !input target_lights_auto
  v_lights_perm: !input target_lights_permanent

trigger:
  - platform: state
    entity_id: !input authorized_people
    to: "home"
    id: "llegada"
  - platform: state
    entity_id: !input motion_sensor
    from: "off"
    to: "on"
    id: "movimiento"

condition:
  - condition: and
    conditions:
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ v_solo_noche == false }}"
          - condition: state
            entity_id: sun.sun
            state: "below_horizon"
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ v_lux_sensor == [] }}"
          - condition: template
            value_template: "{{ states(v_lux_sensor) | float(0) <= (v_lux_threshold | float) }}"

action:
  # 1. Encendido inicial
  - choose:
      - conditions:
          - condition: trigger
            id: "movimiento"
        sequence:
          - delay:
              seconds: "{{ v_on_delay }}"
          - condition: state
            entity_id: !input motion_sensor
            state: "on"
          - service: homeassistant.turn_on
            target: !input target_lights_auto
          - service: homeassistant.turn_on
            target: !input target_lights_permanent
      - conditions:
          - condition: trigger
            id: "llegada"
        sequence:
          - service: homeassistant.turn_on
            target: !input target_lights_auto
          - service: homeassistant.turn_on
            target: !input target_lights_permanent

  # 2. Lógica de apagado (SOLO PARA LUCES AUTO)
  - wait_for_trigger:
      - platform: state
        entity_id: !input motion_sensor
        from: "on"
        to: "off"
        for:
          seconds: "{{ v_off_sec }}"
    timeout:
      minutes: "{{ v_arrival_min }}"
    continue_on_timeout: true

  # 3. Apagado final (SOLO PARA LUCES AUTO)
  - service: homeassistant.turn_off
    target: !input target_lights_auto
