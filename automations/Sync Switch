blueprint:
  name: "Sync Switch"
  description: >
    Sincroniza el estado de varios interruptores. Si uno se enciende, todos se encienden. 
    Si uno se apaga, todos se apagan. Útil para conmutadas con interruptores inteligentes.
  domain: automation
  input:
    synced_entities:
      name: "🔌 Interruptores a sincronizar"
      description: "Selecciona los interruptores que quieres mantener con el mismo estado."
      selector:
        entity:
          domain: 
            - switch
            - light
          multiple: true

mode: restart

trigger:
  - platform: state
    entity_id: !input synced_entities
    from: 
      - "on"
      - "off"
    to:
      - "on"
      - "off"

condition:
  # Evitamos ejecuciones innecesarias si el estado ya es el mismo
  - condition: template
    value_template: "{{ trigger.from_state.state != trigger.to_state.state }}"

action:
  - service: "homeassistant.turn_{{ trigger.to_state.state }}"
    target:
      entity_id: !input synced_entities
