blueprint:
  name: "Interior: Luces por Movimiento (DEBUG MODE)"
  description: >
    Versión de depuración. Envía notificaciones persistentes y logs para ver dónde falla.
  domain: automation
  input:
    motion_entity:
      name: "🏃 Sensor de Movimiento"
      selector:
        entity:
          domain: binary_sensor

    target_lights:
      name: "💡 Luces a controlar"
      selector:
        target:
          entity:
            - domain: light
            - domain: switch

    on_delay:
      name: "⏳ Temporizador de Inicio"
      default: 0
      selector:
        number:
          min: 0
          max: 60
          unit_of_measurement: "segundos"

    off_delay:
      name: "⏱️ Temporizador de Apagado"
      default: 120
      selector:
        number:
          min: 5
          max: 3600
          unit_of_measurement: "segundos"

    use_illuminance:
      name: "☀️ Usar Sensor de Luminosidad"
      default: false
      selector:
        boolean: {}

    illuminance_sensor:
      name: "↳ 👁️ Sensor de Lux"
      default: []
      selector:
        entity:
          domain: sensor
          device_class: illuminance

    illuminance_threshold:
      name: "↳ 🔆 Umbral de Lux"
      default: 50
      selector:
        number:
          min: 1
          max: 1000
          unit_of_measurement: "lux"

    use_time_range:
      name: "⏰ Usar Rango Horario"
      default: false
      selector:
        boolean: {}

    time_start:
      name: "↳ 🕒 Hora de Inicio"
      default: "00:00:00"
      selector:
        time: {}

    time_end:
      name: "↳ 🕒 Hora de Fin"
      default: "23:59:59"
      selector:
        time: {}

    blocking_entity:
      name: "🚫 Entidad de Bloqueo (Opcional)"
      default: []
      selector:
        entity: {}

mode: restart

variables:
  v_use_lux: !input use_illuminance
  v_lux_sensor: !input illuminance_sensor
  v_lux_threshold: !input illuminance_threshold
  v_use_time: !input use_time_range
  v_time_start: !input time_start
  v_time_end: !input time_end
  v_blocking: !input blocking_entity
  v_on_delay: !input on_delay

trigger:
  - platform: state
    entity_id: !input motion_entity
    to: "on"

condition: [] # Sin condiciones para que SIEMPRE entre en action y podamos loguear

action:
  # 0. Notificación de inicio
  - service: system_log.write
    data:
      message: "DEBUG: Sensor detectado!"
      level: info
  - service: persistent_notification.create
    data:
      title: "DEBUG: Movimiento"
      message: "Sensor detectado. Empezando comprobaciones..."

  # 1. Comprobar Bloqueo
  - if:
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ v_blocking in [none, [], ''] }}"
          - condition: template
            value_template: "{{ not is_state(v_blocking, 'on') }}"
    then:
      - service: system_log.write
        data:
          message: "DEBUG: Bloqueo OK (no activo)"
          level: info
    else:
      - service: persistent_notification.create
        data:
          title: "DEBUG: Detenido"
          message: "Bloqueo ACTIVO (entidad: {{ v_blocking }})"
      - stop: "Bloqueo activo"

  # 2. Comprobar Luminosidad
  - if:
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ not v_use_lux }}"
          - condition: template
            value_template: "{{ v_lux_sensor in [none, [], ''] }}"
          - condition: template
            value_template: "{{ states(v_lux_sensor) | float(0) <= (v_lux_threshold | float) }}"
    then:
      - service: system_log.write
        data:
          message: "DEBUG: Luminosidad OK"
          level: info
    else:
      - service: persistent_notification.create
        data:
          title: "DEBUG: Detenido"
          message: "Hay demasiada luz ({{ states(v_lux_sensor) }} lux vs umbral {{ v_lux_threshold }})"
      - stop: "Demasiada luz"

  # 3. Comprobar Horario
  - if:
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ not v_use_time }}"
          - condition: time
            after: !input time_start
            before: !input time_end
    then:
      - service: system_log.write
        data:
          message: "DEBUG: Horario OK"
          level: info
    else:
      - service: persistent_notification.create
        data:
          title: "DEBUG: Detenido"
          message: "Fuera de horario ({{ now().strftime('%H:%M:%S') }} no está entre {{ v_time_start }} y {{ v_time_end }})"
      - stop: "Fuera de horario"

  # 4. Encendido
  - service: persistent_notification.create
    data:
      title: "DEBUG: Encendiendo"
      message: "Todas las condiciones OK. Encendiendo luces."
  
  - delay:
      seconds: "{{ v_on_delay }}"
  
  - if:
      - condition: template
        value_template: "{{ v_on_delay | float > 0 }}"
    then:
      - if:
          - condition: state
            entity_id: !input motion_entity
            state: "on"
        then:
          - service: system_log.write
            data:
              message: "DEBUG: Sigue habiendo movimiento tras delay"
              level: info
        else:
          - service: persistent_notification.create
            data:
              title: "DEBUG: Detenido"
              message: "Ya no hay movimiento tras el delay inicial."
          - stop: "Ya no hay movimiento"

  - service: homeassistant.turn_on
    target: !input target_lights

  # 5. Espera y apagado
  - wait_for_trigger:
      - platform: state
        entity_id: !input motion_entity
        to: "off"
        for:
          seconds: !input off_delay
    timeout:
      hours: 2
    continue_on_timeout: true

  - service: homeassistant.turn_off
    target: !input target_lights
  - service: persistent_notification.create
    data:
      title: "DEBUG: Apagado"
      message: "Tiempo agotado sin movimiento. Luces apagadas."
