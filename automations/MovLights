blueprint:
  name: "Mov Lights V2.2"
  description: >
    Control inteligente de luces interiores mediante sensor de movimiento/presencia.
  domain: automation
  input:
    motion_entity:
      name: "🏃 Sensor de Movimiento"
      selector:
        entity:
          domain: binary_sensor

    target_lights:
      name: "💡 Luces a controlar"
      selector:
        target:
          entity:
            - domain: light
            - domain: switch

    on_delay:
      name: "⏳ Temporizador de Inicio"
      default: 0
      selector:
        number:
          min: 0
          max: 60
          unit_of_measurement: "segundos"

    off_delay:
      name: "⏱️ Temporizador de Apagado"
      default: 120
      selector:
        number:
          min: 5
          max: 3600
          unit_of_measurement: "segundos"

    use_illuminance:
      name: "☀️ Usar Sensor de Luminosidad"
      default: false
      selector:
        boolean: {}

    illuminance_sensor:
      name: "↳ 👁️ Sensor de Lux"
      default: []
      selector:
        entity:
          domain: sensor
          device_class: illuminance

    illuminance_threshold:
      name: "↳ 🔆 Umbral de Lux"
      default: 50
      selector:
        number:
          min: 1
          max: 1000
          unit_of_measurement: "lux"

    use_time_range:
      name: "⏰ Usar Rango Horario"
      default: false
      selector:
        boolean: {}

    time_start:
      name: "↳ 🕒 Hora de Inicio"
      default: "00:00:00"
      selector:
        time: {}

    time_end:
      name: "↳ 🕒 Hora de Fin"
      default: "23:59:59"
      selector:
        time: {}

    blocking_entity:
      name: "🚫 Entidad de Bloqueo (Opcional)"
      default: []
      selector:
        entity: {}

mode: restart

variables:
  v_use_lux: !input use_illuminance
  v_lux_sensor: !input illuminance_sensor
  v_use_time: !input use_time_range
  v_lux_threshold: !input illuminance_threshold
  v_blocking: !input blocking_entity
  v_on_delay: !input on_delay


trigger:
  - platform: state
    entity_id: !input motion_entity
    to: "on"

condition:
  # 1. Bloqueo
  - condition: or
    conditions:
      - condition: template
        value_template: "{{ v_blocking in [none, [], ''] }}"
      - condition: template
        value_template: "{{ not is_state(v_blocking, 'on') }}"

  # 2. Luminosidad
  - condition: or
    conditions:
      - condition: template
        value_template: "{{ not v_use_lux }}"
      - condition: template
        value_template: "{{ v_lux_sensor in [none, [], ''] }}"
      - condition: template
        value_template: "{{ states(v_lux_sensor) | float(0) <= (v_lux_threshold | float) }}"


  # 3. Horario
  - condition: or
    conditions:
      - condition: template
        value_template: "{{ not v_use_time }}"
      - condition: time
        after: !input time_start
        before: !input time_end

action:
  - delay:
      seconds: "{{ v_on_delay }}"
  
  - if:
      - condition: template
        value_template: "{{ v_on_delay | float > 0 }}"
    then:
      - condition: state
        entity_id: !input motion_entity
        state: "on"

  - service: homeassistant.turn_on
    target: !input target_lights

  - wait_for_trigger:
      - platform: state
        entity_id: !input motion_entity
        to: "off"
        for:
          seconds: !input off_delay
    timeout:
      hours: 2
    continue_on_timeout: true

  - service: homeassistant.turn_off
    target: !input target_lights

