blueprint:
  name: "Motion Lights (Simple & Multiple)"
  description: >
    Control optimizado de luces mediante uno o varios sensores de movimiento.
    Si cualquier sensor detecta movimiento, se enciende (condicionado al sol opcional).
    Cuando TODOS los sensores dejen de detectar movimiento por X tiempo, se apaga.
  domain: automation
  input:
    motion_entities:
      name: "🏃 Sensores de Movimiento"
      description: "Selecciona uno o más sensores. Con que uno detecte, basta."
      selector:
        entity:
          domain: binary_sensor
          multiple: true
    target_lights:
      name: "💡 Luces a controlar"
      selector:
        target:
          entity:
            - domain: light
            - domain: switch
    use_sun_night:
      name: "🌙 Solo de Noche"
      description: "Actívalo para que solo funcione si el sol se ha puesto."
      default: false
      selector:
        boolean: {}
    on_delay:
      name: "⏳ Retraso al encender"
      description: "Segundos de movimiento continuo necesarios antes de encender."
      default: 0
      selector:
        number:
          min: 0
          max: 60
          unit_of_measurement: "segundos"
    off_delay:
      name: "⏱️ Retraso al apagar"
      description: "Segundos a esperar tras no detectar NINGÚN movimiento."
      default: 120
      selector:
        number:
          min: 0
          max: 3600
          unit_of_measurement: "segundos"
mode: restart
variables:
  motion_entities: !input motion_entities
  v_use_sun_night: !input use_sun_night
  v_on_delay: !input on_delay
trigger:
  - platform: state
    entity_id: !input motion_entities
    to: "on"
    for:
      seconds: !input on_delay
condition:
  - condition: template
    value_template: >
      {% if v_use_sun_night %}
        {{ is_state('sun.sun', 'below_horizon') }}
      {% else %}
        true
      {% endif %}
action:
  - service: homeassistant.turn_on
    target: !input target_lights
  # Esperar a que TODOS los sensores estén en OFF
  - wait_template: "{{ expand(motion_entities) | selectattr('state', 'eq', 'on') | list | length == 0 }}"
  
  # Una vez todos están en OFF, iniciamos la cuenta atrás para apagar.
  # Si alguien vuelve a moverse durante este tiempo, el trigger "to: on" reiniciará el script completo (mode: restart).
  - delay:
      seconds: !input off_delay
  - service: homeassistant.turn_off
    target: !input target_lights
