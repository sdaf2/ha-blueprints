blueprint:
  name: "Welcome Home"
  description: >
    Enciende luces al llegar a casa (GPS) o por presencia.
  domain: automation
  input:
    authorized_people:
      name: "👥 Miembros Autorizados"
      selector:
        entity:
          domain: person
          multiple: true

    motion_sensor:
      name: "🏃 Sensor de Presencia (Opcional)"
      default: []
      selector:
        entity:
          domain: binary_sensor
          device_class: motion

    target_lights_auto:
      name: "💡 Luces con Auto-Apagado"
      description: "Luces que seguirán la lógica de temporizadores."
      default: 
      selector:
        target:
          entity:
            - domain: light
            - domain: switch

    target_lights_permanent:
      name: "🔦 Luces Permanentes"
      description: "Luces que NO se apagarán automáticamente."
      default: 
      selector:
        target:
          entity:
            - domain: light
            - domain: switch

    only_at_night:
      name: "🌙 Activar solo de noche"
      default: true
      selector:
        boolean: {}

    illuminance_sensor:
      name: "☀️ Sensor de Luz / Estación AEMET"
      default: []
      selector:
        entity:
          domain: sensor

    illuminance_threshold:
      name: "↳ Umbral de Lux"
      default: 50
      selector:
        number:
          min: 1
          max: 1000
          unit_of_measurement: "lux"

    on_delay:
      name: "⏳ Retraso de Inicio (Movimiento)"
      default: 0
      selector:
        number:
          min: 0
          max: 60
          unit_of_measurement: "segundos"

    arrival_duration:
      name: "⏱️ Tiempo de Cortesía (Llegada)"
      default: 5
      selector:
        number:
          min: 1
          max: 30
          unit_of_measurement: "minutos"

    off_delay:
      name: "⏱️ Temporizador de Salida (Presencia)"
      default: 120
      selector:
        number:
          min: 10
          max: 3600
          unit_of_measurement: "segundos"

mode: restart

variables:
  # Capturamos los inputs en variables
  v_motion: !input motion_sensor
  v_lights_auto: !input target_lights_auto
  v_lights_perm: !input target_lights_permanent

trigger:
  - platform: state
    entity_id: !input authorized_people
    to: "home"
    id: "llegada"
  - platform: state
    entity_id: !input motion_sensor
    from: "off"
    to: "on"
    id: "movimiento"

condition:
  - condition: and
    conditions:
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ !input only_at_night == false or is_state('sun.sun', 'below_horizon') }}"
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ !input illuminance_sensor == [] or states(!input illuminance_sensor) | float(0) <= (!input illuminance_threshold | float) }}"

action:
  - choose:
      - conditions:
          - condition: trigger
            id: "movimiento"
        sequence:
          - delay:
              seconds: !input on_delay
          - condition: state
            entity_id: !input motion_sensor
            state: "on"
          - service: homeassistant.turn_on
            target: !input target_lights_auto
          - service: homeassistant.turn_on
            target: !input target_lights_permanent
      - conditions:
          - condition: trigger
            id: "llegada"
        sequence:
          - service: homeassistant.turn_on
            target: !input target_lights_auto
          - service: homeassistant.turn_on
            target: !input target_lights_permanent

  - wait_for_trigger:
      - platform: state
        entity_id: !input motion_sensor
        from: "on"
        to: "off"
        for:
          seconds: !input off_delay
    timeout:
      minutes: !input arrival_duration
    continue_on_timeout: true

  - service: homeassistant.turn_off
    target: !input target_lights_auto
