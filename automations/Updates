alias: "Auto Actualizar Componentes de Home Assistant"
description: "Comprueba e instala todas las actualizaciones disponibles (Add-ons, Supervisor, Core, OS) de forma secuencial y segura a las 04:00 AM, cada 5 minutos o de forma instantánea al detectarse."
mode: queued
max: 10

# 1. ¿CUÁNDO SUCEDE? (Triggers / Disparadores)
trigger:
  # Disparador 1: A las 04:00 AM todos los días (Por seguridad)
  - platform: time
    at: "04:00:00"
    id: "hora_fijada"

  # Disparador 2: En cuanto Home Assistant detecte que hay cualquier actualización disponible
  - platform: template
    value_template: "{{ states.update | selectattr('state', 'eq', 'on') | list | count > 0 }}"
    id: "nueva_actualizacion"

  # Disparador 3: Comprobación periódica cada 5 minutos
  - platform: time_pattern
    minutes: "/5"
    id: "cada_5_minutos"

# 2. ¿SE CUMPLEN LAS CONDICIONES? (Conditions)
condition: [] # No hay condiciones globales. Se evalúa cada paso.

# 3. ¿QUÉ HACEMOS? (Acciones / Actions)
# Las acciones están ordenadas por prioridad para evitar que un reinicio interrumpa otras instalaciones.
action:
  # PASO 1: Actualizar todos los Add-ons primero (no reinician todo el sistema)
  - repeat:
      for_each: >
        {{ states.update 
           | selectattr('state', 'eq', 'on') 
           | rejectattr('entity_id', 'in', [
               'update.home_assistant_core_update', 
               'update.home_assistant_operating_system_update', 
               'update.home_assistant_supervisor_update'
             ]) 
           | map(attribute='entity_id') | list }}
      sequence:
        - action: update.install
          target:
            entity_id: "{{ repeat.item }}"
          data:
            backup: true
        # Pequeña pausa para permitir que el add-on se instale
        - delay: "00:00:30"

  # PASO 2: Actualizar el Supervisor de Home Assistant (si está disponible)
  - if:
      - condition: state
        entity_id: update.home_assistant_supervisor_update
        state: "on"
    then:
      - action: update.install
        target:
          entity_id: update.home_assistant_supervisor_update
        data:
          backup: true
      - delay: "00:01:00"

  # PASO 3: Actualizar Home Assistant Core (provoca reinicio del contenedor)
  - if:
      - condition: state
        entity_id: update.home_assistant_core_update
        state: "on"
    then:
      - action: update.install
        target:
          entity_id: update.home_assistant_core_update
        data:
          backup: true
      - delay: "00:01:00"

  # PASO 4: Actualizar Home Assistant Operating System (provoca reinicio del host)
  - if:
      - condition: state
        entity_id: update.home_assistant_operating_system_update
        state: "on"
    then:
      - action: update.install
        target:
          entity_id: update.home_assistant_operating_system_update
        data:
          backup: true
