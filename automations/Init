blueprint:
  name: "Auto Init"
  description: >
    Inicia y gestiona automáticamente las 4 instancias principales de Home Assistant:
    Core, Supervisor, Observer y Operating System, y envía una notificación.
  domain: automation
  input: {}

mode: single

trigger:
  # Disparador 1: Al arrancar Home Assistant
  - platform: homeassistant
    event: start
    id: "inicio_ha"

  # Disparador 2: Cada 5 minutos periódicamente
  - platform: time_pattern
    minutes: "/5"
    id: "cada_5_minutos"

condition: []

action:
  # INSTANCIA 1: Add-ons y aplicaciones del Supervisor
  - repeat:
      for_each:
        - "core_openthread"
        - "core_mosquitto"
        - "core_configurator"
        - "core_ssh"
        - "a0d7b954_nodered"
        - "a0d7b954_esphome"
        - "a0d7b954_zigbee2mqtt"
      sequence:
        - action: hassio.addon_start
          data:
            addon: "{{ repeat.item }}"

  # INSTANCIA 2: Supervisor de Home Assistant
  - action: hassio.supervisor_restart

  # INSTANCIA 3: Observer de Home Assistant
  - action: hassio.addon_restart
    data:
      addon: "core_observer"

  # INSTANCIA 4: Home Assistant Core y Operating System
  - action: homeassistant.update_entity
    target:
      entity_id: zone.home

  # PASO 5: Notificaciones del Auto-Arranque
  # Se envía tanto una notificación persistente como a tus dispositivos móviles
  - action: persistent_notification.create
    data:
      title: "Auto Arranque ejecutado"
      message: "Se han comprobado y arrancado las 4 instancias de Home Assistant."

  - action: notify.notify
    data:
      title: "Auto Arranque ejecutado"
      message: "Se han comprobado y arrancado las 4 instancias de Home Assistant."
