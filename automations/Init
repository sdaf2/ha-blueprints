blueprint:
  name: "Auto Init"
  description: >
    Inicia y gestiona automáticamente las 4 instancias principales de Home Assistant:
    Core, Supervisor, Observer y Operating System, y envía una notificación.
  domain: automation
  input: {}

mode: single

trigger:
  # Disparador 1: Al arrancar Home Assistant
  - platform: homeassistant
    event: start
    id: "inicio_ha"

  # Disparador 2: Cada 5 minutos periódicamente
  - platform: time_pattern
    minutes: "/1"
    id: "cada_5_minutos"

condition: []

action:
  # INSTANCIA 1: Add-ons y aplicaciones del Supervisor
  - repeat:
      for_each:
        - "openthread_border_router"
        - "core_openthread"
        - "core_openthread_border_router"
        - "core_mosquitto"
        - "core_configurator"
        - "core_ssh"
        - "a0d7b954_nodered"
        - "a0d7b954_esphome"
        - "a0d7b954_zigbee2mqtt"
      sequence:
        - action: hassio.addon_start
          data:
            addon: "{{ repeat.item }}"
